CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DATABASE_URL=postgresql+psycopg://docpipe:docpipe@localhost:5432/docpipe

# Where uploaded PDFs are stored (inside the container).
STORAGE_DIR=/app/data/uploads

# LLM provider. "stub" is a deterministic fake that needs no API key.
# Switch to anthropic/openai once _complete() in app/services/llm.py is wired up.
LLM_PROVIDER=stub
LLM_MODEL=stub-v0
LLM_MAX_INPUT_CHARS=12000

# Retry/backoff for recoverable (LLM) failures.
TASK_MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
RETRY_BACKOFF_MAX=60.0

# Fault injection for exercising the retry path. Leave off in normal use.
#   off | always | first_n
LLM_FAULT_MODE=off
LLM_FAULT_ATTEMPTS=2
