CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DATABASE_URL=postgresql+psycopg://docpipe:docpipe@localhost:5432/docpipe

# Storage backend: "local" writes to STORAGE_DIR on a filesystem the API and
# the worker share; "s3" writes to any S3-compatible object store. Local is
# correct under docker-compose and wrong in production — Railway attaches a
# volume to exactly one service, so the deployed API and worker cannot share a
# disk. See DEPLOY.md.
STORAGE_BACKEND=local

# Local backend only (inside the container).
STORAGE_DIR=/app/data/uploads

# S3 backend only. These are Cloudflare R2 values in the deploy; setting them
# locally is a useful way to test the real storage path before deploying.
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 has no regions; botocore still requires a value.
S3_REGION=auto
S3_PREFIX=uploads

# LLM provider: "anthropic" calls the real API, "stub" is a deterministic fake
# that needs no API key and no network.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# Required when LLM_PROVIDER=anthropic. Put the real key in .env (gitignored),
# never in this file.
ANTHROPIC_API_KEY=sk-ant-...

# Only required if your key is identity-linked — the API returns a 400 naming
# this header when it is needed. Find it in the Console under Settings →
# Workspaces (looks like wrkspc_01...).
ANTHROPIC_WORKSPACE_ID=

# Retry/backoff for recoverable (LLM) failures.
TASK_MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
RETRY_BACKOFF_MAX=60.0

# Fault injection for exercising the retry path. Leave off in normal use.
#   off | always | first_n
LLM_FAULT_MODE=off
LLM_FAULT_ATTEMPTS=2
